<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- 自升级安装 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" tools:ignore="ScopedStorage" />

    <!-- 开机自启 / 定时开关机 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <!-- 前台服务防 OOM Kill（CHUTO e-player 标配） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 以下权限仅 Android 5.0+ 有效，低版本自动忽略 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"
        tools:targetApi="33" />
    <uses-permission android:name="android.permission.DEVICE_POWER" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REBOOT" tools:ignore="ProtectedPermissions" />

    <!-- 系统弹窗（可选：开机向导跳过） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Kiosk 抢占：前台探测（Android 4.4 getRunningTasks 可见全局任务） -->
    <uses-permission android:name="android.permission.GET_TASKS" />

    <application
        android:name=".LumaApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="灵屏播放端"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.LumaSign.Fullscreen"
        tools:targetApi="34">

        <activity
            android:name=".CrashRecoveryActivity"
            android:exported="true"
            android:theme="@style/Theme.LumaSign.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.LumaSign.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- 远程配置深链：lumasync://config?server=http://192.168.1.10:7788 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lumasync" android:host="config" />
            </intent-filter>
        </activity>

        <!-- 崩溃守望前台服务：防 OOM Kill + WakeLock 保持 CPU -->
        <service
            android:name=".CrashWatchdogService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- Kiosk 抢占守护：前台探测 + 应急悬浮窗（压制触拓等第三方抢前台） -->
        <service
            android:name=".KioskGuardService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- 5.0+ Device Owner Kiosk 接收器（adb 一次性注册，4.4 不实例化） -->
        <receiver
            android:name=".KioskAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <!-- priority=999：BOOT_COMPLETED 是有序广播，跨应用按 priority 投递，灵屏先于触拓收到并启动 -->
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".PowerAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- 自升级 APK 安装 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
